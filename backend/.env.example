# Copy to .env and fill in credentials for your local PostgreSQL database.
# On the configured machine, keep the existing generated .env credentials.
DATABASE_URL=postgresql://campusfind:YOUR_PASSWORD@127.0.0.1:5432/campusfind_auth
PORT=3001
CORS_ORIGINS=http://localhost:3000

# Use 0.0.0.0 inside containers; keep loopback for local development.
HOST=127.0.0.1
